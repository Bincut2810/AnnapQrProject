<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Annap.CoffeeQrOrdering.Application\Annap.CoffeeQrOrdering.Application.csproj" />
    <ProjectReference Include="..\Annap.CoffeeQrOrdering.Domain\Annap.CoffeeQrOrdering.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.4" />
    <PackageReference Include="OpenAI" Version="2.1.0" />
    <PackageReference Include="Pgvector" Version="0.2.0" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.2.0" />
    <PackageReference Include="CsvHelper" Version="33.0.1" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Fail the build if the Temperature migration is not discoverable (missing [Migration] attribute). -->
  <Target Name="VerifyOrderItemTemperatureMigrationDiscoverable" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_TempMigrationFile>$(MSBuildProjectDirectory)\Persistence\Migrations\20260805120000_AddOrderItemTemperature.cs</_TempMigrationFile>
    </PropertyGroup>
    <Error
      Condition="!Exists('$(_TempMigrationFile)')"
      Text="Missing migration file Persistence/Migrations/20260805120000_AddOrderItemTemperature.cs" />
    <ReadLinesFromFile File="$(_TempMigrationFile)">
      <Output TaskParameter="Lines" ItemName="_TempMigrationLines" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_TempMigrationAttrLines Include="@(_TempMigrationLines)" Condition="$([System.String]::Copy('%(_TempMigrationLines.Identity)').Contains('[Migration(&quot;20260805120000_AddOrderItemTemperature&quot;)]'))" />
    </ItemGroup>
    <Error
      Condition="'@(_TempMigrationAttrLines)' == ''"
      Text="AddOrderItemTemperature must declare [Migration(&quot;20260805120000_AddOrderItemTemperature&quot;)] so EF can discover it. Undiscoverable migrations cause schema drift and hidden 500s on POST /api/orders." />
  </Target>

</Project>
